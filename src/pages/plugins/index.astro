---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PluginsPage from "../../components/PluginsPage.astro";
import { pluginsPage } from "../../data/plugins";
import { t } from "../../lib/i18n";

const page = pluginsPage.en;
const enUrl = t("en").pluginsUrl;
const ptUrl = t("pt-BR").pluginsUrl;
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale="en"
  enUrl={enUrl}
  ptUrl={ptUrl}
  alternates={{ en: enUrl, pt: ptUrl }}
>
  <PluginsPage locale="en" />
</BaseLayout>
