---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AboutPage from "../../components/AboutPage.astro";
import { about } from "../../data/about";
import { aboutJsonLd } from "../../lib/aboutJsonLd";
import { t } from "../../lib/i18n";

const a = about.en;
const enUrl = t("en").aboutUrl;
const ptUrl = t("pt-BR").aboutUrl;
---

<BaseLayout
  title={a.title}
  description={a.description}
  locale="en"
  enUrl={enUrl}
  ptUrl={ptUrl}
  alternates={{ en: enUrl, pt: ptUrl }}
  type="profile"
  jsonLd={aboutJsonLd(new URL(enUrl, Astro.site), a.description)}
>
  <AboutPage locale="en" />
</BaseLayout>
