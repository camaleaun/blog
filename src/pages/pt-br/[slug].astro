---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostArticle from "../../components/PostArticle.astro";
import { baseUrl, siteName } from "../../lib/i18n";
import { getPosts, type Post } from "../../lib/posts";
import { postJsonLd } from "../../lib/postJsonLd";

export async function getStaticPaths() {
  const posts = await getPosts("pt-BR");
  return posts.map((post) => ({ params: { slug: post.entry.data.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const enUrl = post.translationHref ?? baseUrl;
---

<BaseLayout
  title={`${post.title} — ${siteName}`}
  description={post.description}
  locale="pt-BR"
  enUrl={enUrl}
  ptUrl={post.href}
  alternates={{ en: post.translationHref, pt: post.href }}
  image={post.thumbnail ?? undefined}
  type="article"
  publishedTime={post.date}
  jsonLd={postJsonLd(post, new URL(post.href, Astro.site))}
>
  <PostArticle post={post} />
</BaseLayout>
