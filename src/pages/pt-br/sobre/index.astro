---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AboutPage from "../../../components/AboutPage.astro";
import { about } from "../../../data/about";
import { aboutJsonLd } from "../../../lib/aboutJsonLd";
import { t } from "../../../lib/i18n";

const a = about["pt-BR"];
const enUrl = t("en").aboutUrl;
const ptUrl = t("pt-BR").aboutUrl;
---

<BaseLayout
  title={a.title}
  description={a.description}
  locale="pt-BR"
  enUrl={enUrl}
  ptUrl={ptUrl}
  alternates={{ en: enUrl, pt: ptUrl }}
  type="profile"
  jsonLd={aboutJsonLd(new URL(ptUrl, Astro.site), a.description)}
>
  <AboutPage locale="pt-BR" />
</BaseLayout>
