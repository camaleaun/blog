---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { baseUrl, siteName, t } from "../../lib/i18n";
import { getPosts } from "../../lib/posts";

const posts = await getPosts("pt-BR");
const s = t("pt-BR");
---

<BaseLayout
  title={`${siteName} — ${s.tagline}`}
  description={s.intro}
  locale="pt-BR"
  alternates={{ en: baseUrl, pt: `${baseUrl}pt-br/` }}
>
  <PostList posts={posts} locale="pt-BR" />
</BaseLayout>
