---
import BaseLayout from "../layouts/BaseLayout.astro";
import ExtinguisherGame from "../components/ExtinguisherGame.astro";
import Icon from "../components/Icon.astro";
import { siteName, t, type Locale } from "../lib/i18n";

// One page for both languages (GitHub Pages serves a single 404.html): every
// text comes in both, and the URL picks one (/pt-br/… is Portuguese).
const en = t("en");
const pt = t("pt-BR");
const locales: Locale[] = ["en", "pt-BR"];
---

<BaseLayout
  title={`${en.notFoundTitle} — ${siteName}`}
  description={en.notFoundText}
  locale="en"
  noCanonical
  bilingual={{ title: `${pt.notFoundTitle} — ${siteName}`, description: pt.notFoundText }}
>
  <div class="container not-found">
    {
      locales.map((l) => {
        const s = t(l);
        return (
          <div class="not-found-message" data-locale={l}>
            <h1>{s.notFoundTitle}</h1>
            <p>{s.notFoundText}</p>
            <ul class="not-found-links" role="list">
              <li>
                <a href={s.homeUrl}>
                  {s.notFoundHome}
                  <Icon name="arrowRight" size={16} />
                </a>
              </li>
              <li>
                <a class="not-found-secondary" href={s.gameUrl}>
                  {s.gamePlayPage}
                  <Icon name="arrowRight" size={16} />
                </a>
              </li>
            </ul>
          </div>
        );
      })
    }
    <ExtinguisherGame />
  </div>
</BaseLayout>

<style lang="scss">
  .not-found {
    display: grid;
    justify-items: center;
    gap: var(--gt-space-8);
    max-width: 64rem;
    padding-block: var(--gt-space-8) var(--gt-space-12);
  }

  .not-found-message {
    text-align: center;

    h1 {
      margin: 0 0 var(--gt-space-3);
      font-size: var(--gt-h1);
      letter-spacing: -0.03em;
    }

    p {
      margin: 0;
      font-size: var(--gt-text-lg);
    }
  }

  .not-found-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gt-space-3);
    margin: var(--gt-space-6) 0 0;
    padding: 0;
    list-style: none;

    a {
      display: inline-flex;
      align-items: center;
      gap: var(--gt-space-2);
      min-height: var(--gt-target);
      padding-inline: var(--gt-space-4);
      border-radius: var(--gt-radius-full);
      background: var(--gt-primary);
      color: var(--gt-paper);
      font-weight: 600;
      text-decoration: none;
    }

    a:hover {
      background: var(--gt-primary-strong);
      color: var(--gt-paper);
    }

    .not-found-secondary {
      border: 1px solid var(--gt-border);
      background: transparent;
      color: var(--gt-ink);
    }

    .not-found-secondary:hover {
      background: var(--gt-surface);
      color: var(--gt-ink);
    }
  }
</style>
