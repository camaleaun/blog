---
import "../styles/global.scss";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { baseUrl, siteName, t, type Locale } from "../lib/i18n";
import ogEn from "../assets/og-en.png";
import ogPt from "../assets/og-pt-br.png";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  enUrl?: string;
  ptUrl?: string;
  /** The other language's URL only when this exact page is translated. */
  alternates?: { en?: string; pt?: string };
  image?: ImageMetadata;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
  /** No canonical URL: the 404 is served at any path (GitHub Pages answers it with status 404, so it is never indexed). */
  noCanonical?: boolean;
  /**
   * The 404: one page for both languages. Header, footer and the page's own
   * `[data-locale]` blocks come in both; a script in `head` switches to
   * Portuguese under /pt-br/ (title, description, `lang`) before first paint,
   * and CSS hides the other language.
   */
  bilingual?: { title: string; description: string };
}

const {
  title,
  description,
  locale,
  enUrl = baseUrl,
  ptUrl = `${baseUrl}pt-br/`,
  alternates,
  image,
  type = "website",
  publishedTime,
  jsonLd,
  noCanonical = false,
  bilingual
} = Astro.props;

const s = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;

// Social images must be PNG/JPG; a post's thumbnail is resized to 1200 wide.
const social = image
  ? await getImage({ src: image, width: 1200, format: "jpg" })
  : await getImage({ src: locale === "pt-BR" ? ogPt : ogEn, format: "png" });
const socialUrl = absolute(social.src);
const socialWidth = social.attributes.width ?? 1200;
const socialHeight = social.attributes.height ?? (image ? 1200 : 630);
const locales: Locale[] = bilingual ? ["en", "pt-BR"] : [locale];
const ptPrefix = `${baseUrl}pt-br/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical.href} />}
    {alternates?.en && <link rel="alternate" hreflang="en" href={absolute(alternates.en)} />}
    {alternates?.pt && <link rel="alternate" hreflang="pt-BR" href={absolute(alternates.pt)} />}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />
    <meta name="author" content={siteName} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={s.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content={String(socialWidth)} />
    <meta property="og:image:height" content={String(socialHeight)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let mode = "auto";
        try {
          mode = localStorage.getItem("theme-mode") || "auto";
        } catch {}
        if (mode === "light" || mode === "dark") root.dataset.theme = mode;
        root.dataset.themeMode = mode;
      })();
    </script>
    {
      bilingual && (
        <script
          is:inline
          define:vars={{ ptPrefix, ptTitle: bilingual.title, ptDescription: bilingual.description }}
        >
          if (location.pathname === ptPrefix.slice(0, -1) || location.pathname.startsWith(ptPrefix)) {
            document.documentElement.lang = "pt-BR";
            document.title = ptTitle;
            document.querySelector('meta[name="description"]')?.setAttribute("content", ptDescription);
          }
        </script>
      )
    }
  </head>
  <body>
    {
      locales.map((l) => (
        <SiteHeader
          locale={l}
          enUrl={bilingual ? t("en").homeUrl : enUrl}
          ptUrl={bilingual ? t("pt-BR").homeUrl : ptUrl}
          tagged={!!bilingual}
        />
      ))
    }

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <SiteFooter locales={locales} />
  </body>
</html>

<style lang="scss">
  main {
    outline: none;
  }
</style>
