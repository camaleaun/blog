---
import "../styles/global.scss";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Brand from "../components/Brand.astro";
import LanguageSwitch from "../components/LanguageSwitch.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import Icon from "../components/Icon.astro";
import { Picture } from "astro:assets";
import wapuu from "../assets/wapuu.webp";
import { baseUrl, githubUrl, siteName, t, type Locale } from "../lib/i18n";
import ogEn from "../assets/og-en.png";
import ogPt from "../assets/og-pt-br.png";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  enUrl?: string;
  ptUrl?: string;
  /** The other language's URL only when this exact page is translated. */
  alternates?: { en?: string; pt?: string };
  image?: ImageMetadata;
  type?: "website" | "article" | "profile";
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
  /** No canonical URL: the 404 is served at any path (GitHub Pages answers it with status 404, so it is never indexed). */
  noCanonical?: boolean;
}

const {
  title,
  description,
  locale,
  enUrl = baseUrl,
  ptUrl = `${baseUrl}pt-br/`,
  alternates,
  image,
  type = "website",
  publishedTime,
  jsonLd,
  noCanonical = false
} = Astro.props;

const s = t(locale);
const canonical = new URL(Astro.url.pathname, Astro.site);
const absolute = (path: string) => new URL(path, Astro.site).href;

// Social images must be PNG/JPG; a post's thumbnail is resized to 1200 wide.
const social = image
  ? await getImage({ src: image, width: 1200, format: "jpg" })
  : await getImage({ src: locale === "pt-BR" ? ogPt : ogEn, format: "png" });
const socialUrl = absolute(social.src);
const socialWidth = social.attributes.width ?? 1200;
const socialHeight = social.attributes.height ?? (image ? 1200 : 630);
const year = new Date().getFullYear();
const current = (url: string) => (Astro.url.pathname === url ? "page" : undefined);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noCanonical && <link rel="canonical" href={canonical.href} />}
    {alternates?.en && <link rel="alternate" hreflang="en" href={absolute(alternates.en)} />}
    {alternates?.pt && <link rel="alternate" hreflang="pt-BR" href={absolute(alternates.pt)} />}
    {alternates?.en && <link rel="alternate" hreflang="x-default" href={absolute(alternates.en)} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121418" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />
    <meta name="author" content={siteName} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={s.ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noCanonical && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={socialUrl} />
    <meta property="og:image:width" content={String(socialWidth)} />
    <meta property="og:image:height" content={String(socialHeight)} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        let mode = "auto";
        try {
          mode = localStorage.getItem("theme-mode") || "auto";
        } catch {}
        if (mode === "light" || mode === "dark") root.dataset.theme = mode;
        root.dataset.themeMode = mode;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>

    <header class="site-header">
      <div class="container site-header-inner">
        <Brand locale={locale} />
        <nav class="site-tools" aria-label={s.menu}>
          <a class="nav-link" href={s.pluginsUrl} aria-current={current(s.pluginsUrl)}>{s.plugins}</a>
          <a class="nav-link" href={s.aboutUrl} aria-current={current(s.aboutUrl)}>{s.about}</a>
          <LanguageSwitch locale={locale} enUrl={enUrl} ptUrl={ptUrl} />
        </nav>
        <ThemeToggle locale={locale} />
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer-inner">
        <a class="site-footer-about" href={s.aboutUrl}>
          <Picture src={wapuu} formats={["avif", "webp"]} widths={[48, 96]} sizes="3rem" alt="" loading="lazy" />
          {s.aboutAuthor}
        </a>
        <p>
          © {year} {siteName} · camaleaun
        </p>
        <p class="site-footer-note">{s.footer}</p>
        <a class="site-footer-link" href={githubUrl} rel="me">
          <Icon name="github" size={18} />
          {s.github}
        </a>
      </div>
    </footer>
  </body>
</html>

<style lang="scss">
  @use "../styles/mq" as *;

  // Sticky: stays at the top while scrolling, translucent over the content.
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--gt-border);
    background: color-mix(in srgb, var(--gt-paper) 88%, transparent);
    -webkit-backdrop-filter: saturate(1.6) blur(12px);
    backdrop-filter: saturate(1.6) blur(12px);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .site-header {
      background: var(--gt-paper);
    }
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gt-space-2) var(--gt-space-4);
    padding-block: var(--gt-space-3);
  }

  .site-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gt-space-1);
    margin-left: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--gt-target);
    padding-inline: var(--gt-space-3);
    border-radius: var(--gt-radius-full);
    color: var(--gt-ink);
    font-size: var(--gt-text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--gt-duration) var(--gt-ease);
  }

  .nav-link:hover {
    background: var(--gt-surface);
    color: var(--gt-ink);
  }

  .nav-link[aria-current="page"] {
    background: var(--gt-primary-soft);
    font-weight: 650;
  }

  // A thin rule between the page link and the language links.
  .site-tools :global(.languages) {
    margin-left: var(--gt-space-2);
    padding-left: var(--gt-space-3);
    border-left: 1px solid var(--gt-border);
  }

  @include mobile {
    .site-header-inner {
      justify-content: space-between;
    }

    .site-tools {
      margin-left: 0;
      order: 3;
      width: 100%;
      margin-inline: calc(-1 * var(--gt-space-2));
    }

    .nav-link,
    .site-tools :global(.languages a) {
      padding-inline: var(--gt-space-2);
    }

    .site-tools :global(.languages) {
      margin-left: 0;
      padding-left: 0;
      border-left: 0;
    }
  }

  main {
    outline: none;
  }

  .site-footer {
    border-top: 1px solid var(--gt-border);
    background: var(--gt-surface);
    color: var(--gt-muted);
    font-size: var(--gt-text-sm);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gt-space-2) var(--gt-space-6);
    padding-block: var(--gt-space-6);

    p {
      margin: 0;
    }
  }

  .site-footer-note {
    flex: 1;
  }

  .site-footer-about {
    display: inline-flex;
    align-items: center;
    gap: var(--gt-space-3);
    min-height: var(--gt-target);
    color: var(--gt-ink);
    font-weight: 600;
    text-decoration: none;

    :global(img) {
      width: 3rem;
      height: auto;
      transition: transform var(--gt-duration) var(--gt-ease);
    }
  }

  .site-footer-about:hover {
    color: var(--gt-primary);
    text-decoration: underline;

    :global(img) {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  .site-footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--gt-space-2);
    min-height: var(--gt-target);
    color: var(--gt-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .site-footer-link:hover {
    color: var(--gt-primary);
    text-decoration: underline;
  }
</style>
