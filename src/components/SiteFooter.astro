---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import wapuu from "../assets/wapuu.webp";
import { githubUrl, siteName, t, type Locale } from "../lib/i18n";

interface Props {
  /** One locale; the 404 passes both and gets each text tagged `data-locale` (see BaseLayout). */
  locales: Locale[];
}

const { locales } = Astro.props;
const both = locales.length > 1;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer-inner">
    {
      both ? (
        // One mascot image (a hidden copy would count as a broken image), a link per language.
        <span class="site-footer-about">
          <Picture src={wapuu} formats={["avif", "webp"]} widths={[48, 96]} sizes="3rem" alt="" loading="lazy" />
          {locales.map((l) => (
            <a href={t(l).aboutUrl} data-locale={l}>
              {t(l).aboutAuthor}
            </a>
          ))}
        </span>
      ) : (
        <a class="site-footer-about" href={t(locales[0]).aboutUrl}>
          <Picture src={wapuu} formats={["avif", "webp"]} widths={[48, 96]} sizes="3rem" alt="" loading="lazy" />
          {t(locales[0]).aboutAuthor}
        </a>
      )
    }
    <p>
      © {year} {siteName} · camaleaun
    </p>
    {
      locales.map((l) => (
        <p class="site-footer-note" data-locale={both ? l : undefined}>
          {t(l).footer}
        </p>
      ))
    }
    <a class="site-footer-link" href={githubUrl} rel="me">
      <Icon name="github" size={18} />
      {t(locales[0]).github}
    </a>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--gt-border);
    background: var(--gt-surface);
    color: var(--gt-muted);
    font-size: var(--gt-text-sm);
  }

  .site-footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gt-space-2) var(--gt-space-6);
    padding-block: var(--gt-space-6);

    p {
      margin: 0;
    }
  }

  .site-footer-note {
    flex: 1;
  }

  .site-footer-about {
    display: inline-flex;
    align-items: center;
    gap: var(--gt-space-3);
    min-height: var(--gt-target);
    color: var(--gt-ink);
    font-weight: 600;
    text-decoration: none;

    :global(img) {
      width: 3rem;
      height: auto;
      transition: transform var(--gt-duration) var(--gt-ease);
    }
  }

  span.site-footer-about a {
    color: inherit;
    text-decoration: none;
  }

  span.site-footer-about a:hover {
    color: var(--gt-primary);
    text-decoration: underline;
  }

  .site-footer-about:hover {
    color: var(--gt-primary);
    text-decoration: underline;

    :global(img) {
      transform: rotate(-8deg) scale(1.08);
    }
  }

  .site-footer-link {
    display: inline-flex;
    align-items: center;
    gap: var(--gt-space-2);
    min-height: var(--gt-target);
    color: var(--gt-ink);
    font-weight: 500;
    text-decoration: none;
  }

  .site-footer-link:hover {
    color: var(--gt-primary);
    text-decoration: underline;
  }
</style>
