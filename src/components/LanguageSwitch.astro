---
import { t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  enUrl: string;
  ptUrl: string;
}

const { locale, enUrl, ptUrl } = Astro.props;
const links = [
  { locale: "en" as const, href: enUrl, short: "EN" },
  { locale: "pt-BR" as const, href: ptUrl, short: "PT" }
];
---

<ul class="languages" aria-label={t(locale).language} role="list">
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        hreflang={link.locale}
        lang={link.locale}
        aria-current={link.locale === locale ? "page" : undefined}
      >
        {t(link.locale).languageName}
      </a>
    </li>
  ))}
</ul>

<style lang="scss">
  .languages {
    display: flex;
    align-items: center;
    gap: var(--gt-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--gt-target);
    padding-inline: var(--gt-space-3);
    border-radius: var(--gt-radius-full);
    color: var(--gt-ink);
    font-size: var(--gt-text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: background-color var(--gt-duration) var(--gt-ease);
  }

  a:hover {
    background: var(--gt-surface);
    color: var(--gt-ink);
  }

  a[aria-current="page"] {
    background: var(--gt-primary-soft);
    color: var(--gt-ink);
    font-weight: 650;
  }
</style>
